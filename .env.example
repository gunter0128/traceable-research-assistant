DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
SECRET_KEY=your-secret-key
OPENAI_API_KEY=your-openai-api-key
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
# 選填：雲端才設定。沒設定時上傳後直接在同一個 request 裡處理（本機開發用）
# SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/123456789012/your-queue-name

# 選填：企業內部版改接自己架的模型服務（vLLM，呼叫方式跟 OpenAI 一樣，docs/decisions/037）。不設定就是 OpenAI
# EMBEDDING_BASE_URL=http://localhost:8001/v1
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# EMBEDDING_DIMENSION=1024
# EMBEDDING_QUERY_PREFIX="Instruct: Given a web search query, retrieve relevant passages that answer the query\nQuery:"
# ANSWER_BASE_URL=http://localhost:8000/v1
# ANSWER_MODEL=<vLLM 掛上的 adapter 名稱>
# ANSWER_EXTRA_BODY={"temperature": 0, "top_p": 0.8, "top_k": 20, "min_p": 0, "presence_penalty": 1.5, "chat_template_kwargs": {"enable_thinking": false}}
# ANSWER_TIMEOUT=45
