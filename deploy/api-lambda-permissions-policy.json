{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendToDocumentsQueue",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:ap-southeast-1:416113247224:trace-app-documents-queue"
    },
    {
      "Sid": "UploadCheckAndDeletePdfs",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::traceable-research-assistant-416113247224-ap-southeast-1/documents/*"
    },
    {
      "Sid": "TellMissingFromForbidden",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::traceable-research-assistant-416113247224-ap-southeast-1",
      "Condition": { "StringLike": { "s3:prefix": "documents/*" } }
    },
    {
      "Sid": "ReadAppSecrets",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:ap-southeast-1:416113247224:secret:trace-app/*"
    }
  ]
}
