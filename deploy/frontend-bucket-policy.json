{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyCloudFrontReadsFrontend",
      "Effect": "Allow",
      "Principal": {
        "Service": "cloudfront.amazonaws.com"
      },
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::traceable-research-assistant-frontend-416113247224/*",
      "Condition": {
        "StringEquals": {
          "AWS:SourceArn": "arn:aws:cloudfront::416113247224:distribution/E2IPB9CUGG6K2W"
        }
      }
    }
  ]
}
