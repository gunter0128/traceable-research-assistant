# 地端版的設定（docs/decisions/045）：複製成 .env 再填。.env 不進 git
# 密碼隨便產生一串長的就好：python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
SECRET_KEY=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# 兩個模型的網址
# 模型已經在這台主機上跑、或透過 SSH 通道連到別台（例如筆電連實驗室）：
ANSWER_BASE_URL=http://host.docker.internal:8000/v1
EMBEDDING_BASE_URL=http://host.docker.internal:8001/v1
# 用 --profile gpu 連模型一起開的話，改成：
# ANSWER_BASE_URL=http://vllm-answer:8000/v1
# EMBEDDING_BASE_URL=http://vllm-embed:8001/v1

# 只有 --profile gpu 才用到
# VLLM_VERSION：vLLM 的版本，跟訓練、驗收時用的一樣
# MODELS_DIR：放模型檔的資料夾（Hugging Face 的快取，HF_HOME）；ADAPTERS_DIR：放 adapter 的資料夾
VLLM_VERSION=
MODELS_DIR=
ADAPTERS_DIR=
